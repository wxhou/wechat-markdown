{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "公众号排版",
  "version": "0.1.0",
  "identifier": "com.wxhou.wechat-markdown",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5188",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "公众号排版",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage", "deb", "rpm"],
    "category": "Productivity",
    "shortDescription": "把 Markdown 排成公众号可直接粘贴的精致 HTML",
    "longDescription": "粘贴 Markdown，一键排版为可直接粘贴到微信公众号编辑器的精致 HTML；33 套主题 / 4 大合集，含合规校验与三项导出。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
